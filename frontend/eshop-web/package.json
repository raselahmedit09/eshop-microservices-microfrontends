{
  "name": "eshop-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:all": "concurrently -n shell,catalog,basket,orders \"ng serve shell\" \"ng serve mfe-catalog\" \"ng serve mfe-basket\" \"ng serve mfe-orders\"",
    "generate:api": "npm run openapi:build && npm run openapi:clean && openapi-generator-cli generate",
    "openapi:clean": "node -e \"require('fs').rmSync('projects/shared/src/lib/api/generated', { recursive: true, force: true })\"",
    "openapi:build": "dotnet build ../../backend/Services/Catalog/Catalog.API && dotnet build ../../backend/Services/Basket/Basket.API && dotnet build ../../backend/Services/Ordering/Ordering.API"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@softarc/native-federation-node": "^3.3.4",
    "angular-auth-oidc-client": "^22.0.3",
    "es-module-shims": "^1.5.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "~21.2.6",
    "@angular-devkit/build-angular": "^21.2.30",
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "concurrently": "^10.0.7",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
